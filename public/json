    {
      "title": "Automatic fixes risk breaking code without strict safety constraints",
      "source": "hn",
      "url": "https://alint.org/blog/the-automatic-fix-problem-four-questions/",
      "date": "2026-10-09",
      "tags": [
        "automatic-fixes",
        "catchup",
