    {
      "title": "Query pushdown in Postgres foreign data wrappers requires negotiation",
      "source": "hn",
      "url": "https://clickhouse.com/blog/postgres-fdw-pushdown-negotiation",
      "date": "2026-10-11",
      "tags": [
        "catchup",
