---
import { SITE_METADATA } from '../config';

interface Props {
	label?: string;
	showDelayNote?: boolean;
}

const { label, showDelayNote = false } = Astro.props;
---

<footer class="edition-colophon">
	{showDelayNote && (
		<p class="edition-delay-note">
			Note: Editions are updated 2 days late so that we get time to popularity and top HN articles settle.
		</p>
	)}
	<div class="colophon-row">
		{label ? `End of Edition — ${label}` : SITE_METADATA.name} &mdash; Curated by <a href="https://arpitbhayani.me/" target="_blank" rel="noopener noreferrer">Arpit Bhayani</a>
	</div>
	<div class="colophon-row">
		<a href="http://github.com/arpitbbhayani/the-daily-diff" target="_blank" rel="noopener noreferrer">GitHub</a> &bull; <a href="/stats/">Stats</a> &bull; <a href="/rss.xml">RSS</a> &bull; &copy; <a href="https://tdd.cat" target="_blank" rel="noopener noreferrer">tdd.cat</a>
	</div>
</footer>
