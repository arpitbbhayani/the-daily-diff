---
import { SITE_METADATA } from '../config';

interface Props {
	label?: string;
	showDelayNote?: boolean;
}

const { label, showDelayNote = false } = Astro.props;
---

<footer class="edition-colophon">
	{showDelayNote && (
		<p class="edition-delay-note">
			Note: Editions are published with a 2-day settling window so the highest-signal discussions and insights surface.
		</p>
	)}
	<div class="colophon-row">
		{label ? `End of Edition — ${label}` : SITE_METADATA.name} &mdash; The Daily Diff | An Engineering Newspaper curated by <a href={SITE_METADATA.curatorUrl} target="_blank" rel="noopener noreferrer">{SITE_METADATA.curator}</a>
	</div>
	<div class="colophon-row">
		<a href="https://github.com/arpitbbhayani/the-daily-diff" target="_blank" rel="noopener noreferrer">GitHub</a> &bull; <a href="/stats/">Stats</a> &bull; <a href="/rss.xml">RSS</a> &bull; <a href="/llms.txt" target="_blank" rel="noopener noreferrer">llms.txt</a> &bull; &copy; <a href="https://tdd.cat">tdd.cat</a>
	</div>
</footer>
