---
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import EditionPage from '../../components/EditionPage.astro';
import { isNewsStory } from '../../lib/storyClassification';

export async function getStaticPaths() {
	const editions = await getCollection('editions');
	const chronological = [...editions].sort((a, b) => a.data.date.localeCompare(b.data.date));

	const allDays = chronological.map((edition) => ({
		day: edition.data.date,
		label: new Date(`${edition.data.date}T00:00:00`).toLocaleDateString('en-US', {
			weekday: 'short',
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		}),
	}));

	return chronological.map((edition, index) => {
		const day = edition.data.date;
		const stories = edition.data.stories.map((story) => {
			const comments = story.comments || (story.hn_id ? `https://news.ycombinator.com/item?id=${story.hn_id}` : undefined);
			const bodyHtml = story.social_post ? (marked.parse(story.social_post) as string) : '';
			return {
				slug: story.id,
				title: story.title,
				source: story.source,
				url: story.url,
				why_read: story.why_read,
				authors: story.authors || [],
				image: story.image || undefined,
				interest_score: story.interest_score,
				comments,
				hn_id: story.hn_id,
				section: story.section,
				isNews: isNewsStory(story),
				depth_score: story.depth_score,
				novelty_score: story.novelty_score,
				utility_score: story.utility_score,
				bodyHtml,
			};
		});

		return {
			params: { day },
			props: {
				day,
				stories,
				issue: index + 1,
				totalIssues: chronological.length,
				prevDay: chronological[index - 1]?.data.date ?? null,
				nextDay: chronological[index + 1]?.data.date ?? null,
				allDays: [...allDays].reverse(),
			},
		};
	});
}

const props = Astro.props;
---

<EditionPage {...props} />
