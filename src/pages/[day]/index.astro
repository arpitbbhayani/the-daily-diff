---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const SOURCE_LABEL: Record<string, string> = {
	arxiv: 'arXiv Dispatch',
	hn: 'Hacker News Wire',
};

export async function getStaticPaths() {
	const entries = await getCollection('articles');
	const byDay = new Map<string, typeof entries>();
	for (const entry of entries) {
		const day = entry.id.split('/')[0];
		const list = byDay.get(day) ?? [];
		list.push(entry);
		byDay.set(day, list);
	}

	const chronological = [...byDay.keys()].sort((a, b) => a.localeCompare(b));

	const allDays = chronological.map((day) => ({
		day,
		label: new Date(`${day}T00:00:00`).toLocaleDateString('en-US', {
			weekday: 'short',
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		}),
	}));

	return Promise.all(
		chronological.map(async (day, index) => {
			const dayEntries = byDay.get(day)!;
			const sorted = [...dayEntries].sort((a, b) => a.id.localeCompare(b.id));
			const articles = await Promise.all(
				sorted.map(async (entry) => {
					const { Content } = await render(entry);
					return {
						slug: entry.id.split('/')[1],
						title: entry.data.title,
						source: entry.data.source,
						url: entry.data.url,
						categories: entry.data.categories,
						why_read: entry.data.why_read,
						authors: entry.data.authors,
						Content,
					};
				})
			);
			return {
				params: { day },
				props: {
					day,
					articles,
					issue: index + 1,
					totalIssues: chronological.length,
					prevDay: chronological[index - 1] ?? null,
					nextDay: chronological[index + 1] ?? null,
					allDays: [...allDays].reverse(),
				},
			};
		})
	);
}

interface ArticleProps {
	slug: string;
	title: string;
	source: string;
	url: string;
	categories?: string;
	why_read?: string;
	authors: string[];
	Content: any;
}

const { day, articles, issue, totalIssues, prevDay, nextDay, allDays } = Astro.props as {
	day: string;
	articles: ArticleProps[];
	issue: number;
	totalIssues: number;
	prevDay: string | null;
	nextDay: string | null;
	allDays: { day: string; label: string }[];
};

const label = new Date(`${day}T00:00:00`).toLocaleDateString('en-US', {
	weekday: 'long',
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});

function kickerFor(article: ArticleProps) {
	if (article.categories) return article.categories.toUpperCase();
	return (SOURCE_LABEL[article.source] ?? article.source).toUpperCase();
}

function bylineFor(article: ArticleProps) {
	if (article.authors.length > 0) return `By ${article.authors.join(', ')}`;
	return null;
}

function sourceLabelFor(article: ArticleProps) {
	return SOURCE_LABEL[article.source] ?? article.source.toUpperCase();
}

const lead = articles[0];
const rest = articles.slice(1);
---

<Layout title={`The Daily Diff // ${label}`}>
	<nav id="edition-rail" class="edition-rail" aria-label="Edition controls">
		<a href="/" class="rail-btn" aria-label="Back to archive" title="Back to archive">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"></path><path d="m12 19-7-7 7-7"></path></svg>
		</a>

		<div class="rail-divider"></div>

		<button id="prev-day-btn" class="rail-btn" disabled={!prevDay} aria-label="Previous edition" title="Previous edition">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
		</button>

		<div class="rail-date-picker" title="Jump to edition">
			<svg class="rail-date-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
			<select id="edition-date-select" class="edition-date-select" aria-label="Jump to edition">
				{allDays.map(({ day: d, label: l }) => (
					<option value={d} selected={d === day}>{l}</option>
				))}
			</select>
		</div>

		<button id="next-day-btn" class="rail-btn" disabled={!nextDay} aria-label="Next edition" title="Next edition">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
		</button>

		<div class="rail-divider"></div>

		<button id="download-jpg-btn" class="rail-btn" aria-label="Download JPG" title="Download JPG">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>
		</button>

		<button id="download-pdf-btn" class="rail-btn rail-btn-primary" aria-label="Download PDF" title="Download PDF">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M12 18v-6"></path><path d="m9 15 3 3 3-3"></path></svg>
		</button>
	</nav>

	<main class="page-container page-container--with-rail">
		<article id="newspaper-sheet" class="newspaper-sheet" data-day={day} data-count={articles.length}>
			<header class="masthead">
				<div class="masthead-eyebrow">
					<span>Vol. I &middot; No. {String(issue).padStart(3, '0')} of {totalIssues}</span>
					<span>{articles.length} {articles.length === 1 ? 'Story' : 'Stories'}</span>
				</div>
				<h1 class="masthead-name">The Daily Diff</h1>
				<hr class="masthead-rule-thick" />
				<div class="masthead-dateline">
					<span class="dateline-main">{label}</span>
					<span>arpitbhayani.me</span>
				</div>
			</header>

			{lead && (
				<section class="lead-story">
					<div class="story-kicker">{kickerFor(lead)}</div>
					<h2 class="story-headline">
						<a href={lead.url} target="_blank" rel="noopener noreferrer">{lead.title}</a>
					</h2>
					<div class="story-byline">
						{bylineFor(lead) && <>{bylineFor(lead)}<span class="story-source-sep">&middot;</span></>}
						<a class="story-source-link" href={lead.url} target="_blank" rel="noopener noreferrer">{sourceLabelFor(lead)} &rsaquo;</a>
					</div>
					{lead.why_read && <p class="story-deck">{lead.why_read}</p>}
					<div class="story-body content blog-content">
						<lead.Content />
					</div>
				</section>
			)}

			{rest.length > 0 && (
				<section class="newspaper-columns">
					{rest.map((article) => (
						<article class="story">
							<div class="story-kicker">{kickerFor(article)}</div>
							<h3 class="story-headline">
								<a href={article.url} target="_blank" rel="noopener noreferrer">{article.title}</a>
							</h3>
							<div class="story-byline">
								{bylineFor(article) && <>{bylineFor(article)}<span class="story-source-sep">&middot;</span></>}
								<a class="story-source-link" href={article.url} target="_blank" rel="noopener noreferrer">{sourceLabelFor(article)} &rsaquo;</a>
							</div>
							{article.why_read && <p class="story-deck">{article.why_read}</p>}
							<div class="story-body content blog-content">
								<article.Content />
							</div>
						</article>
					))}
				</section>
			)}

			<footer class="edition-colophon">
				End of Edition &mdash; {label} &mdash; The Daily Diff
			</footer>
		</article>
	</main>

	<div id="toast" class="toast">
		<span id="toast-msg"></span>
	</div>
</Layout>

<script>
	const day = document.getElementById('newspaper-sheet')!.getAttribute('data-day') as string;

	const prevBtn = document.getElementById('prev-day-btn') as HTMLButtonElement;
	const nextBtn = document.getElementById('next-day-btn') as HTMLButtonElement;
	const dateSelect = document.getElementById('edition-date-select') as HTMLSelectElement;
	const downloadJpgBtn = document.getElementById('download-jpg-btn') as HTMLButtonElement;
	const downloadPdfBtn = document.getElementById('download-pdf-btn') as HTMLButtonElement;
	const toast = document.getElementById('toast') as HTMLElement;
	const toastMsg = document.getElementById('toast-msg') as HTMLElement;

	let toastTimer: ReturnType<typeof setTimeout>;
	function showToast(msg: string, sticky = false) {
		toastMsg.textContent = msg;
		toast.classList.add('is-visible');
		clearTimeout(toastTimer);
		if (!sticky) {
			toastTimer = setTimeout(() => toast.classList.remove('is-visible'), 2500);
		}
	}
	function hideToast() {
		toast.classList.remove('is-visible');
	}

	dateSelect.addEventListener('change', () => {
		window.location.href = `/${dateSelect.value}/`;
	});

	prevBtn?.addEventListener('click', () => {
		const el = document.querySelectorAll('#edition-date-select option');
		const idx = Array.from(el).findIndex((o) => (o as HTMLOptionElement).value === day);
		const target = (el[idx + 1] as HTMLOptionElement | undefined)?.value;
		if (target) window.location.href = `/${target}/`;
	});

	nextBtn?.addEventListener('click', () => {
		const el = document.querySelectorAll('#edition-date-select option');
		const idx = Array.from(el).findIndex((o) => (o as HTMLOptionElement).value === day);
		const target = (el[idx - 1] as HTMLOptionElement | undefined)?.value;
		if (target) window.location.href = `/${target}/`;
	});

	const THEME_BG: Record<string, [number, number, number]> = {
		dark: [0x22, 0x1f, 0x19],
		light: [0xf8, 0xf4, 0xe8],
	};

	function currentThemeBg(): [number, number, number] {
		const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
		return THEME_BG[theme];
	}

	async function captureSheet() {
		const html2canvas = (await import('html2canvas')).default;
		const sheet = document.getElementById('newspaper-sheet') as HTMLElement;
		const storyCount = Number(sheet.dataset.count ?? '0');
		const scale = storyCount > 40 ? 1 : storyCount > 15 ? 1.25 : 1.5;
		const [r, g, b] = currentThemeBg();
		const bg = `rgb(${r}, ${g}, ${b})`;

		sheet.classList.add('exporting');
		try {
			return await html2canvas(sheet, {
				backgroundColor: bg,
				scale,
				useCORS: true,
				logging: false,
				// Fixed-position overlays (theme toggle, toast) don't belong in the
				// printed edition and html2canvas mis-renders fixed elements anyway.
				ignoreElements: (el) => el.id === 'theme-toggle' || el.id === 'toast' || el.id === 'edition-rail',
			});
		} finally {
			sheet.classList.remove('exporting');
		}
	}

	// Rather than slicing a PDF page at a fixed pixel height (which lands
	// mid-line as often as not), walk backwards from the ideal break row to
	// find a row that's almost entirely background color — a paragraph or
	// story gap — and cut there instead.
	function findCleanBreakRow(
		ctx: CanvasRenderingContext2D,
		canvasWidth: number,
		idealRow: number,
		earliestRow: number,
		bg: [number, number, number]
	): number {
		const bandHeight = idealRow - earliestRow + 1;
		if (bandHeight <= 1) return idealRow;

		const { data } = ctx.getImageData(0, earliestRow, canvasWidth, bandHeight);
		const [bgR, bgG, bgB] = bg;
		const tolerance = 20;
		const strideX = 3;

		let bestOffset = bandHeight - 1;
		let bestScore = -1;

		for (let offset = bandHeight - 1; offset >= 0; offset--) {
			const rowStart = offset * canvasWidth * 4;
			let blank = 0;
			let total = 0;
			for (let x = 0; x < canvasWidth; x += strideX) {
				const i = rowStart + x * 4;
				total++;
				if (
					Math.abs(data[i] - bgR) <= tolerance &&
					Math.abs(data[i + 1] - bgG) <= tolerance &&
					Math.abs(data[i + 2] - bgB) <= tolerance
				) {
					blank++;
				}
			}
			const score = blank / total;
			if (score > bestScore) {
				bestScore = score;
				bestOffset = offset;
			}
			if (score > 0.995) break;
		}

		return earliestRow + bestOffset;
	}

	downloadJpgBtn.addEventListener('click', async () => {
		downloadJpgBtn.disabled = true;
		showToast('Printing edition to JPG…', true);
		try {
			const canvas = await captureSheet();
			const dataUrl = canvas.toDataURL('image/jpeg', 0.92);
			const a = document.createElement('a');
			a.href = dataUrl;
			a.download = `catchup-${day}.jpg`;
			a.click();
			showToast('JPG downloaded');
		} catch (err) {
			console.error(err);
			showToast('Failed to generate JPG');
		} finally {
			downloadJpgBtn.disabled = false;
		}
	});

	downloadPdfBtn.addEventListener('click', async () => {
		downloadPdfBtn.disabled = true;
		showToast('Printing edition to PDF…', true);
		try {
			const { jsPDF } = await import('jspdf');
			const canvas = await captureSheet();
			const ctx = canvas.getContext('2d')!;
			const bg = currentThemeBg();

			const pageWidthMm = 210; // A4
			const pageHeightMm = 297;
			const marginMm = 10;
			const contentWidthMm = pageWidthMm - marginMm * 2;
			const contentHeightMm = pageHeightMm - marginMm * 2;

			const pxPerMm = canvas.width / contentWidthMm;
			const idealSliceHeightPx = Math.floor(contentHeightMm * pxPerMm);
			const maxSearchPx = Math.floor(idealSliceHeightPx * 0.2);

			const pdf = new jsPDF('p', 'mm', 'a4');
			let renderedPx = 0;
			let pageIndex = 0;

			while (renderedPx < canvas.height) {
				const remainingPx = canvas.height - renderedPx;
				let sliceHeightPx = Math.min(idealSliceHeightPx, remainingPx);

				// Only hunt for a clean break when another page follows —
				// the final slice just ends wherever the content ends.
				if (sliceHeightPx === idealSliceHeightPx && remainingPx > idealSliceHeightPx) {
					const idealBreakRow = renderedPx + idealSliceHeightPx;
					const earliestRow = renderedPx + (idealSliceHeightPx - maxSearchPx);
					const breakRow = findCleanBreakRow(ctx, canvas.width, idealBreakRow, earliestRow, bg);
					sliceHeightPx = breakRow - renderedPx;
				}

				const pageCanvas = document.createElement('canvas');
				pageCanvas.width = canvas.width;
				pageCanvas.height = sliceHeightPx;
				const pageCtx = pageCanvas.getContext('2d')!;
				pageCtx.drawImage(canvas, 0, renderedPx, canvas.width, sliceHeightPx, 0, 0, canvas.width, sliceHeightPx);

				const imgData = pageCanvas.toDataURL('image/jpeg', 0.92);
				const sliceHeightMm = sliceHeightPx / pxPerMm;

				if (pageIndex > 0) pdf.addPage();
				pdf.addImage(imgData, 'JPEG', marginMm, marginMm, contentWidthMm, sliceHeightMm);

				renderedPx += sliceHeightPx;
				pageIndex++;
			}

			pdf.save(`catchup-${day}.pdf`);
			showToast('PDF downloaded');
		} catch (err) {
			console.error(err);
			showToast('Failed to generate PDF');
		} finally {
			downloadPdfBtn.disabled = false;
		}
	});
</script>
