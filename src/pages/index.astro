---
import { getCollection } from 'astro:content';

const entries = await getCollection('articles');
const days = [...new Set(entries.map((entry) => entry.id.split('/')[0]))].sort();
const latestDay = days.at(-1);
const target = latestDay ? `/${latestDay}/` : '/archive/';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0; url=${target}`} />
		<link rel="canonical" href={target} />
		<title>The Daily Diff</title>
	</head>
	<body>
		<p>Redirecting to the <a href={target}>latest edition</a>&hellip;</p>
	</body>
</html>
