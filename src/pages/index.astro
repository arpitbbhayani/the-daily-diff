---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const entries = await getCollection('articles');

const byDay = new Map<string, number>();
for (const entry of entries) {
	const day = entry.id.split('/')[0];
	byDay.set(day, (byDay.get(day) ?? 0) + 1);
}

const days = [...byDay.entries()]
	.sort(([a], [b]) => b.localeCompare(a))
	.map(([day, count]) => ({
		day,
		count,
		label: new Date(`${day}T00:00:00`).toLocaleDateString('en-US', {
			weekday: 'long',
			year: 'numeric',
			month: 'long',
			day: 'numeric',
		}),
	}));
---

<Layout title="Catchup // Archive Index">
	<main class="page-container">
		<header class="page-header">
			<div class="hud-status">
				<span class="status-indicator-dot pulsing"></span>
				<span class="status-text">SYS.STATUS: ONLINE // ARCHIVES SYNCHRONIZED</span>
			</div>
			<h1 class="page-title">CATCHUP<span class="accent-cursor">_</span></h1>
			<p class="page-subtitle">Engineering intelligence. Decoded daily, one batch at a time.</p>
		</header>

		{
			days.length === 0 ? (
				<div class="empty-state">
					<div class="empty-state-icon">
						<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
					</div>
					<h3 class="empty-state-title">No Data Clusters Located</h3>
					<p class="empty-state-desc">Drop a folder of markdown documents into <code>src/content/articles/</code> to initialize the primary core.</p>
				</div>
			) : (
				<div class="days-grid">
					{days.map(({ day, count, label }) => (
						<a class="date-card" href={`/${day}/`}>
							<div class="date-card-content">
								<div class="date-card-meta">SYS_REC // {day}</div>
								<h2 class="date-card-title">{label}</h2>
								<div class="date-card-count">
									<span class="badge">[ {String(count).padStart(2, '0')}_ARTICLE{count === 1 ? '' : 'S'} ]</span>
								</div>
							</div>
							<div class="date-card-icon">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
							</div>
						</a>
					))}
				</div>
			)
		}
	</main>
</Layout>
