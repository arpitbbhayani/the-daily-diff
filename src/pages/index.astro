---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const entries = await getCollection('articles');

const byDay = new Map<string, number>();
for (const entry of entries) {
	const day = entry.id.split('/')[0];
	byDay.set(day, (byDay.get(day) ?? 0) + 1);
}

const days = [...byDay.entries()]
	.sort(([a], [b]) => b.localeCompare(a))
	.map(([day, count]) => ({
		day,
		count,
		label: new Date(`${day}T00:00:00`).toLocaleDateString('en-US', {
			weekday: 'long',
			year: 'numeric',
			month: 'long',
			day: 'numeric',
		}),
	}));
---

<Layout title="Catchup">
	<main class="page-container">
		<header class="page-header">
			<h1 class="page-title">Catchup</h1>
			<p class="page-subtitle">Engineering, one day at a time.</p>
		</header>

		{
			days.length === 0 ? (
				<div class="empty-state">
					<p>No days yet. Drop a folder into <code>src/content/articles/</code> to get started.</p>
				</div>
			) : (
				<div class="days-grid">
					{days.map(({ day, count, label }) => (
						<a class="date-card" href={`/${day}/`}>
							<div class="date-card-content">
								<h2 class="date-card-title">{label}</h2>
								<div class="date-card-count">
									<span class="badge">{count} article{count === 1 ? '' : 's'}</span>
								</div>
							</div>
							<div class="date-card-icon">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
							</div>
						</a>
					))}
				</div>
			)
		}
	</main>
</Layout>
