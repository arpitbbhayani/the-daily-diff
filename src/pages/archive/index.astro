---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ThemeToggleButton from '../../components/ThemeToggleButton.astro';
import Footer from '../../components/Footer.astro';
import { SITE_METADATA } from '../../config';

const entries = await getCollection('stories');

const byDay = new Map<string, number>();
for (const entry of entries) {
	const day = entry.id.split('/')[0];
	byDay.set(day, (byDay.get(day) ?? 0) + 1);
}

const chronological = [...byDay.entries()].sort(([a], [b]) => a.localeCompare(b));

const days = chronological
	.map(([day, count], index) => ({
		day,
		count,
		issue: index + 1,
		label: new Date(`${day}T00:00:00`).toLocaleDateString('en-US', {
			weekday: 'short',
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		}),
	}))
	.reverse();

const latestDay = days[0]?.day;
const archiveSchema = {
	"@type": "CollectionPage",
	"@id": "https://tdd.cat/archive/#collection",
	"url": "https://tdd.cat/archive/",
	"name": `Archive — ${SITE_METADATA.name}`,
	"description": `Browse past editions of ${SITE_METADATA.name}, a daily newspaper of curated engineering insights, software architecture, and systems engineering by ${SITE_METADATA.curator}.`,
	"isPartOf": {
		"@type": "WebSite",
		"name": SITE_METADATA.name,
		"url": "https://tdd.cat/"
	}
};

const breadcrumbSchema = {
	"@type": "BreadcrumbList",
	"itemListElement": [
		{
			"@type": "ListItem",
			"position": 1,
			"name": SITE_METADATA.name,
			"item": "https://tdd.cat/"
		},
		{
			"@type": "ListItem",
			"position": 2,
			"name": "Archive",
			"item": "https://tdd.cat/archive/"
		}
	]
};

const itemListSchema = {
	"@type": "ItemList",
	"name": "Past Editions of The Daily Diff",
	"numberOfItems": days.length,
	"itemListElement": days.slice(0, 30).map((d, index) => ({
		"@type": "ListItem",
		"position": index + 1,
		"name": `Issue #${d.issue}: ${d.label}`,
		"url": `https://tdd.cat/${d.day}/`
	}))
};
---

<Layout
	title={`Archive — ${SITE_METADATA.name} | Curated by ${SITE_METADATA.curator}`}
	description={`Browse past editions of ${SITE_METADATA.name}, a daily newspaper of high-signal software engineering, systems architecture, and technical breakdowns curated by ${SITE_METADATA.curator}.`}
	jsonLd={[archiveSchema, breadcrumbSchema, itemListSchema]}
>
	<main class="page-container archive-page">
		<header class="archive-header">
			<div class="archive-title-group">
				<h1 class="archive-heading">Archive</h1>
				<span class="archive-count">{days.length} {days.length === 1 ? 'Edition' : 'Editions'}</span>
			</div>
			<div class="archive-actions-group">
				{latestDay && <a class="archive-latest-link" href={`/${latestDay}/`}>Latest &rsaquo;</a>}
				<ThemeToggleButton />
			</div>
		</header>
		<hr class="archive-rule-thin" />

		<p class="archive-note">
			Editions are published with a 2-day settling window so the highest-signal discussions and insights surface.
		</p>

		{
			days.length === 0 ? (
				<div class="empty-state">
					<h3 class="empty-state-title">No Editions Printed Yet</h3>
					<p class="empty-state-desc">Drop a folder of markdown documents into <code>src/content/stories/</code> to print the first issue.</p>
				</div>
			) : (
				<div class="archive-list">
					{days.map(({ day, count, issue, label }) => (
						<a class="archive-item" href={`/${day}/`}>
							<span class="archive-item-num">{String(issue).padStart(3, '0')}</span>
							<span class="archive-item-title">{label}</span>
							<span class="archive-item-meta">{count} {count === 1 ? 'Story' : 'Stories'}</span>
						</a>
					))}
				</div>
			)
		}
		<Footer />
	</main>
</Layout>
