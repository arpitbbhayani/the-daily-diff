---
import '../styles/main.scss';

interface Props {
	title?: string;
}

const { title = 'Catchup' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
			(function () {
				const getSavedTheme = () => {
					const saved = localStorage.getItem('catchup-theme');
					if (saved) return saved;
					return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				};
				const theme = getSavedTheme();
				document.documentElement.dataset.theme = theme;

				// Sync UI on load
				window.addEventListener('DOMContentLoaded', () => {
					const themeToggle = document.getElementById('theme-toggle');
					const updateUI = (currentTheme) => {
						const valSpan = document.querySelector('.theme-val');
						if (valSpan) {
							valSpan.textContent = currentTheme.toUpperCase();
						}
					};

					updateUI(theme);

					if (themeToggle) {
						themeToggle.addEventListener('click', () => {
							const current = document.documentElement.dataset.theme || 'dark';
							const next = current === 'dark' ? 'light' : 'dark';
							document.documentElement.dataset.theme = next;
							localStorage.setItem('catchup-theme', next);
							updateUI(next);
							window.dispatchEvent(new CustomEvent('theme-changed', { detail: next }));
						});
					}
				});
			})();
		</script>
	</head>
	<body>
		<!-- Tech Matrix Dot Grid Background -->
		<div class="grid-bg"></div>
		
		<!-- Floating Cyber Theme Controller -->
		<button id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle Cyber Theme">
			<span class="theme-toggle-icon">
				<svg class="sun" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
				<svg class="moon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
			</span>
			<span class="theme-toggle-text">SYS.THEME // <span class="theme-val">DARK</span></span>
		</button>

		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
